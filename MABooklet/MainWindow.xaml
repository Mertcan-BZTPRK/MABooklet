<Window x:Class="MABooklet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booklet Maker" Height="550" Width="800"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="15" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="4" Height="20" Background="{StaticResource AccentColor}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="14">
                        <Hyperlink NavigateUri="https://www.linkedin.com/in/mertcan-boztoprak"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   TextDecorations="None"
                                   Foreground="{StaticResource TextMain}">
                            <Run Text="MAB TECH" FontWeight="Bold"/>
                            <Run Text=" | " Foreground="{StaticResource TextMuted}"/>
                            <Run Text="BOOKLET MAKER"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    
                    <Button Content="—" Width="35" Height="30" Style="{StaticResource ControlBtn}" Click="btnMinimize_Click"/>
                    <Button x:Name="maximizeBut" Content="⬛" Width="35" Height="30" Style="{StaticResource ControlBtn}" Click="btnMaximize_Click" FontSize="14"/>
                    <Button Content="✕" Width="35" Height="30" Style="{StaticResource ControlBtn}" Click="btnClose_Click" Foreground="#ff5f56"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PDF Booklet &amp; Reader" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentColor}" 
           HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <Border Grid.Row="1" x:Name="DropZone" CornerRadius="12" Background="{StaticResource BgLight}" Margin="0,0,0,25"
                        AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="2,2,2,2" SnapsToDevicePixels="True">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="lblFileInfo" Text="PDF dosyasını buraya bırak" FontSize="16" Foreground="{StaticResource TextMain}" 
                                   Margin="0,15,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="6" Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <TextBox x:Name="txtOutputPath" IsReadOnly="True" VerticalContentAlignment="Center" Height="40" 
                                 Padding="10,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" Text="Çıktı Yolu: ..."/>
                    </Border>

                    <Button Content="..." Grid.Column="1" Width="50" Height="40" Margin="10,0,0,0" 
                            Style="{StaticResource ModernBtn}" Click="btnSelectOutput_Click"/>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Vertical">
                    <ProgressBar x:Name="pBar" Height="4" Margin="0,0,0,20" IsIndeterminate="True" Visibility="Collapsed" 
                                 Foreground="{StaticResource AccentColor}" Background="{StaticResource BgLight}" BorderThickness="0"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="🎙 Sesli Okuyucu Modu" Height="50" Margin="0,0,10,0" 
                                Style="{StaticResource ModernBtn}" Background="#1e8e3e" Click="btnReaderMode_Click"/>

                        <Button Grid.Column="1" Content="📖 Kitapçık Oluştur" Height="50" Margin="10,0,10,0" 
                                Style="{StaticResource ModernBtn}" Background="{StaticResource AccentColor}" Foreground="Black" Click="btnConvert_Click"/>
                        <Button Grid.Column="2" Content="🔗 PDF Birleştirici" Height="50" 
                        Style="{StaticResource ModernBtn}" Background="#FF1727BD" Click="btnMerger_Click" Margin="14,0,10,0"/>
                        <Button Grid.Column="3" Content="✂ Ayırıcı" Height="50" Margin="5,0,0,0"
                                Style="{StaticResource ModernBtn}" Background="#D93025" Click="btnSplitter_Click"/>
                    </Grid>
                     </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>