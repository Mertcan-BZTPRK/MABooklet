<Window x:Class="MABooklet.SplitterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Görsel PDF Ayırıcı" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="15" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="4" Height="20" Background="{StaticResource AccentColor}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="14">
                        <Hyperlink NavigateUri="https://www.linkedin.com/in/mertcan-boztoprak"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   TextDecorations="None"
                                   Foreground="{StaticResource TextMain}">
                            <Run Text="MAB TECH" FontWeight="Bold"/>
                            <Run Text=" | " Foreground="{StaticResource TextMuted}"/>
                            <Run Text="AYIRICI"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="txtFileName" Text="" Foreground="#AAA" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="—" Width="35" Height="30" Style="{StaticResource ControlBtn}" Click="btnMinimize_Click"/>
                    <Button Content="✕" Width="35" Height="30" Style="{StaticResource ControlBtn}" Click="btnClose_Click" Foreground="#ff5f56"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="dropZone" Grid.Column="0" CornerRadius="10" Background="{StaticResource BgLight}" 
                        BorderBrush="#444" BorderThickness="1,1,1,1" Height="50" AllowDrop="True" Cursor="Hand"
                        Drop="dropZone_Drop" DragEnter="dropZone_DragEnter" DragLeave="dropZone_DragLeave"
                        MouseLeftButtonDown="dropZone_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="📂" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="PDF'i buraya sürükle veya TIKLA" Foreground="#AAA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0">
                    <Border CornerRadius="5" Background="#333" BorderBrush="#555" BorderThickness="1" Height="35" Width="100">
                        <TextBox x:Name="txtSearch" Background="Transparent" Foreground="White" BorderThickness="0" 
                                 Tag="Sayfa Bul..." KeyDown="txtSearch_KeyDown"
                                 VerticalContentAlignment="Center" Padding="5,0" ToolTip="Örn: 7-10 yazıp Enter'a bas"/>
                    </Border>

                    <Button Content="Tümünü Seç" Width="90" Height="35" Margin="5,0" Style="{StaticResource ModernBtn}" Click="btnSelectAll_Click" FontSize="11"/>
                    <Button Content="Temizle" Width="70" Height="35" Style="{StaticResource ModernBtn}" Click="btnClearSelection_Click" Background="#555" FontSize="11"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="20,0,20,0" Background="{StaticResource BgLight}" CornerRadius="10" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="lstPages" Background="Transparent" BorderThickness="0" 
                             SelectionMode="Multiple"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="10"
                             PreviewMouseLeftButtonDown="lstPages_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="lstPages_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="lstPages_PreviewMouseLeftButtonUp">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" IsItemsHost="True" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="#252526" Width="140" Height="200">
                                                <Grid>
                                                    <ContentPresenter/>
                                                    <Border x:Name="Overlay" Background="#60007ACC" CornerRadius="6" Visibility="Collapsed">
                                                        <TextBlock Text="✓" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Image Source="{Binding Image}" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Background="#333" CornerRadius="10" Margin="0,5,0,0" Padding="8,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PageLabel}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid x:Name="loadingGrid" Visibility="Collapsed" Background="#AA000000">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="100" Height="10" Margin="0,0,0,10"/>
                            <TextBlock Text="Sayfalar Yükleniyor..." Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="20,0,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="⇐ Geri" Width="100" Height="45" Style="{StaticResource ModernBtn}" Background="#555" Click="btnBack_Click"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="lblSelectedCount" Text="0 Sayfa Seçildi" Foreground="#AAA" HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="AYIR VE KAYDET" Width="180" Height="45" 
                        Style="{StaticResource ModernBtn}" Background="#D93025" Click="btnSplit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>